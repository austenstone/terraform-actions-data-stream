// Enrichment layer: step and log detail the data stream does not carry.
//
// The stream tells you a job finished. It does not tell you which step was slow,
// which step failed, or what the job printed. Both gaps close with the REST API,
// keyed on fields the stream already gives you:
//
//   check_run_id -> GET /repositories/{repository_id}/actions/jobs/{check_run_id}
//                   real display name + steps[] with per-step timings
//   run_id       -> GET /repositories/{repository_id}/actions/runs/{run_id}/logs
//                   zip of log bodies
//
// Both routes accept a numeric repository id, so nothing here needs an owner/repo
// lookup. See scripts/ingest-steps.py and scripts/ingest-logs.py.
//
// Tables are populated out-of-band, so this script only creates the schema.
// Everything stays empty and harmless until you run the ingesters.

// ---------------------------------------------------------------- schema

.create-merge table WorkflowSteps (
    run_id:long, attempt:int, check_run_id:long, repo:string,
    job_name:string, job_key:string, job_conclusion:string,
    runner_name:string, labels:string,
    step_number:int, step_name:string, step_status:string, step_conclusion:string,
    started_at:datetime, completed_at:datetime, duration_seconds:real
)

.create-or-alter table WorkflowSteps ingestion json mapping "StepsMap" '[{"column":"run_id","path":"$.run_id"},{"column":"attempt","path":"$.attempt"},{"column":"check_run_id","path":"$.check_run_id"},{"column":"repo","path":"$.repo"},{"column":"job_name","path":"$.job_name"},{"column":"job_key","path":"$.job_key"},{"column":"job_conclusion","path":"$.job_conclusion"},{"column":"runner_name","path":"$.runner_name"},{"column":"labels","path":"$.labels"},{"column":"step_number","path":"$.step_number"},{"column":"step_name","path":"$.step_name"},{"column":"step_status","path":"$.step_status"},{"column":"step_conclusion","path":"$.step_conclusion"},{"column":"started_at","path":"$.started_at"},{"column":"completed_at","path":"$.completed_at"},{"column":"duration_seconds","path":"$.duration_seconds"}]'

.create-merge table WorkflowLogs (
    timestamp: datetime,
    repo: string,
    run_id: long,
    attempt: int,
    job_name: string,
    job_index: int,
    step: string,
    severity: string,
    message: string,
    line_no: int
)
.create-or-alter table WorkflowLogs ingestion json mapping "WorkflowLogsMapping"
'[{"column":"timestamp","path":"$.timestamp"},{"column":"repo","path":"$.repo"},{"column":"run_id","path":"$.run_id"},{"column":"attempt","path":"$.attempt"},{"column":"job_name","path":"$.job_name"},{"column":"job_index","path":"$.job_index"},{"column":"step","path":"$.step"},{"column":"severity","path":"$.severity"},{"column":"message","path":"$.message"},{"column":"line_no","path":"$.line_no"}]'
.alter table WorkflowLogs policy streamingingestion enable
.create-merge table LogArchive (
    run_id: long,
    attempt: int,
    repo: string,
    archived_at: datetime,
    job_count: int,
    line_count: long,
    bytes_zip: long,
    bytes_raw: long
)
.create-or-alter table LogArchive ingestion json mapping "LogArchiveMapping"
'[{"column":"run_id","path":"$.run_id"},{"column":"attempt","path":"$.attempt"},{"column":"repo","path":"$.repo"},{"column":"archived_at","path":"$.archived_at"},{"column":"job_count","path":"$.job_count"},{"column":"line_count","path":"$.line_count"},{"column":"bytes_zip","path":"$.bytes_zip"},{"column":"bytes_raw","path":"$.bytes_raw"}]'
.alter table LogArchive policy streamingingestion enable


// ------------------------------------------------------------- functions

// Step-level analytics.
//
// Source is the WorkflowSteps table, populated by steps.py from the REST job
// API keyed on the stream's check_run_id. This is ground truth from the
// service -- real step names, real per-step timings -- not log parsing.
//
// Why the API and not the logs: ##[group] markers in a log body are not steps.
// "Runner Image Provisioner" is a group printed inside the single "Set up job"
// step. Group-derived timings answer a different question and are exposed
// separately as WorkflowGroupFacts().

.create-or-alter function with (docString="Real steps from the job API, enriched with run context", folder="steps") StepFacts() {
    WorkflowSteps
    | join kind=leftouter (
        RunFacts()
        | project run_id, attempt, workflow_name, branch, trigger, run_conclusion = conclusion
      ) on run_id, attempt
    | project timestamp = started_at, run_id, attempt, check_run_id, repo,
              workflow_name, branch, trigger, run_conclusion,
              job_name, job_key, job_conclusion, runner_name, labels,
              step_number, step_name, step_status, step_conclusion,
              started_at, completed_at, duration_seconds,
              ran = step_conclusion !in ("skipped", "cancelled"),
              // Set up job / Post * / Complete job are runner-injected, not authored
              synthetic = step_name in ("Set up job", "Complete job")
                          or step_name startswith "Post "
                          or step_name startswith "Set up runner"
}

.create-or-alter function with (docString="Duration distribution per step name", folder="steps") StepStats() {
    StepFacts()
    | where ran and duration_seconds >= 0
    | summarize runs        = count(),
                workflows   = dcount(workflow_name),
                p50         = round(percentile(duration_seconds, 50), 1),
                p95         = round(percentile(duration_seconds, 95), 1),
                max_seconds = round(max(duration_seconds), 1),
                total_hours = round(sum(duration_seconds) / 3600.0, 2),
                failures    = countif(step_conclusion == "failure")
      by step_name, synthetic
    | extend failure_rate = round(100.0 * failures / runs, 1)
    | order by total_hours desc
}

// Where the wall-clock actually goes. Splits each job into authored work vs
// runner overhead (setup, post-actions, teardown) so "our CI is slow" can be
// answered with a number instead of a shrug.
.create-or-alter function with (docString="Authored step time vs runner overhead per job", folder="steps") JobTimeSplit() {
    StepFacts()
    | where ran and duration_seconds >= 0
    | summarize authored_seconds  = sumif(duration_seconds, not(synthetic)),
                overhead_seconds  = sumif(duration_seconds, synthetic),
                steps             = count(),
                any_failure       = countif(step_conclusion == "failure") > 0,
                job_name          = take_any(job_name),
                workflow_name     = take_any(workflow_name),
                repo              = take_any(repo)
      by check_run_id, run_id, attempt
    | extend total_seconds  = authored_seconds + overhead_seconds
    | extend overhead_pct   = iff(total_seconds > 0, round(100.0 * overhead_seconds / total_seconds, 1), 0.0)
}

// The step that broke the job. One row per failed job, so failure triage stops
// at "which step" instead of "which job".
.create-or-alter function with (docString="First failing step per job, with the step that preceded it", folder="steps") StepFailures() {
    StepFacts()
    | where step_conclusion == "failure"
    | summarize arg_min(step_number, *) by check_run_id
    | project timestamp, run_id, attempt, check_run_id, repo, workflow_name, branch,
              job_name, runner_name, failed_step = step_name, step_number,
              duration_seconds, labels
}

.create-or-alter function with (docString="Failure hotspots ranked by blast radius", folder="steps") StepFailureHotspots() {
    StepFacts()
    | where ran
    | summarize total = count(), failures = countif(step_conclusion == "failure"),
                repos = dcount(repo), workflows = dcount(workflow_name),
                wasted_hours = round(sumif(duration_seconds, step_conclusion == "failure") / 3600.0, 2)
      by step_name
    | where failures > 0
    | extend failure_rate = round(100.0 * failures / total, 1)
    | order by failures desc
}

// Step spans, parented to the job spans OtelSpans() already emits, using the
// same githubreceiver hashing. Union this with OtelSpans() for a complete
// run -> job -> step trace tree. This closes the gap OtelSpans() documents.
.create-or-alter function with (docString="Step-level OTel spans, parented to OtelSpans() job spans", folder="otel") OtelStepSpans() {
    StepFacts()
    | where ran and duration_seconds >= 0
    | project trace_id   = substring(hash_sha256(strcat(run_id, attempt, "t")), 0, 32),
              span_id    = substring(hash_sha256(strcat(check_run_id, "-s", step_number)), 16, 16),
              parent_id  = substring(hash_sha256(strcat(check_run_id, "-j")), 16, 16),
              span_kind  = "INTERNAL",
              name       = step_name,
              start_time = started_at, end_time = completed_at,
              run_id, attempt, repository_id = repo,
              ["cicd.pipeline.name"]             = workflow_name,
              ["cicd.pipeline.run.id"]           = tostring(run_id),
              ["cicd.pipeline.task.name"]        = job_name,
              ["cicd.pipeline.task.run.id"]      = tostring(check_run_id),
              ["cicd.pipeline.action.name"]      = step_name,
              ["cicd.pipeline.action.number"]    = step_number,
              ["cicd.pipeline.action.result"]    = step_conclusion,
              ["cicd.worker.name"]               = runner_name
}

.create-or-alter function with (docString="Full run/job/step trace tree, githubreceiver-compatible", folder="otel") OtelTraceTree() {
    union OtelSpans(), OtelStepSpans()
}

// Log-derived analytics. Depends on WorkflowLogs (one row per log line).
//
// This is the layer the Data Stream alone cannot produce: the stream carries
// run and job grain only, so OtelSpans() has a documented gap at step level.
// ##[group]/##[endgroup] markers in the log bodies close it.

.execute database script <|
//
// ---------------------------------------------------------------- step facts
//
// Pairs ##[group] with its ##[endgroup] by ordinal within a job rather than by
// step name, because the same step name can legitimately appear twice in one job.
// A group with no matching endgroup (job cancelled or crashed mid-step) yields a
// null end and is flagged truncated rather than silently dropped.
.create-or-alter function with (docString="One row per step, derived from ##[group] markers", folder="logs") WorkflowGroupFacts() {
    WorkflowLogs
    | where severity in ("group", "endgroup")
    | order by run_id asc, attempt asc, job_index asc, line_no asc
    | extend jobkey = strcat(run_id, "/", attempt, "/", job_index)
    | extend ordinal = row_cumsum(toint(severity == "group"), jobkey != prev(jobkey))
    | summarize started   = minif(timestamp, severity == "group"),
                ended     = maxif(timestamp, severity == "endgroup"),
                step_name = take_any(step),
                repo      = take_any(repo),
                job_name  = take_any(job_name)
      by run_id, attempt, job_index, ordinal
    | extend truncated = isnull(ended)
    | extend duration_seconds = iff(truncated, real(null), (ended - started) / 1s)
    | project run_id, attempt, repo, job_name, job_index, step_ordinal = ordinal,
              step_name, started, ended, duration_seconds, truncated
}

// Per-step log volume and error counts, joined onto the step boundaries.
.create-or-alter function with (docString="Log ##[group] blocks enriched with line counts and severity rollups", folder="logs") WorkflowGroupStats() {
    let line_stats = WorkflowLogs
      | where severity !in ("group", "endgroup") and isnotempty(step)
      | summarize lines = count(),
                  errors = countif(severity == "error"),
                  warnings = countif(severity == "warning"),
                  bytes = sum(strlen(message))
        by run_id, attempt, job_index, step;
    WorkflowGroupFacts()
    | join kind=leftouter line_stats on $left.run_id == $right.run_id
        and $left.attempt == $right.attempt
        and $left.job_index == $right.job_index
        and $left.step_name == $right.step
    | project run_id, attempt, repo, job_name, job_index, step_ordinal, step_name,
              started, ended, duration_seconds, truncated,
              lines = coalesce(lines, 0), errors = coalesce(errors, 0),
              warnings = coalesce(warnings, 0), bytes = coalesce(bytes, 0)
}

//

// OTel LogRecord shape. trace_id is computable from the log row alone — no join —
// because it hashes only run_id + attempt. span_id needs the job span, so that
// correlation is a join against JobFacts().
.create-or-alter function with (docString="Log lines as OTel LogRecords, trace-correlated", folder="otel") OtelLogRecords() {
    let sev = dynamic({"error": 17, "warning": 13, "notice": 10, "info": 9});
    let jobs = JobFacts() | where ran | project run_id, attempt, job_name, check_run_id;
    WorkflowLogs
    | where severity !in ("group", "endgroup")
    | join kind=leftouter jobs on run_id, attempt, job_name
    | project ["time_unix_nano"]      = timestamp,
              ["severity_text"]       = toupper(severity),
              ["severity_number"]     = toint(sev[severity]),
              ["body"]                = message,
              trace_id = substring(hash_sha256(strcat(run_id, attempt, "t")), 0, 32),
              span_id  = iff(isnotnull(check_run_id),
                             substring(hash_sha256(strcat(check_run_id, "-j")), 16, 16), ""),
              ["cicd.pipeline.run.id"]     = tostring(run_id),
              ["cicd.pipeline.task.name"]  = job_name,
              ["cicd.pipeline.action.name"] = step,
              ["vcs.repository.id"]        = repo
}

//
// -------------------------------------------------------------- error triage
//
// The reason to keep log bodies queryable at all: fleet-wide failure clustering.
// Numbers, hex, UUIDs, paths and durations are masked so that the same failure
// from different runs collapses to one signature.
.create-or-alter function with (docString="Error and warning lines normalised into clusterable signatures", folder="logs") LogFailureSignatures() {
    WorkflowLogs
    | where severity in ("error", "warning")
    | extend signature = message
    | extend signature = replace_regex(signature, @"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}", "<uuid>")
    | extend signature = replace_regex(signature, @"[0-9a-fA-F]{40}", "<sha>")
    | extend signature = replace_regex(signature, @"(/[\w.\-]+){2,}", "<path>")
    | extend signature = replace_regex(signature, @"\d+(\.\d+)?(ms|s|m|h)\b", "<dur>")
    | extend signature = replace_regex(signature, @"\d+", "<n>")
    | project timestamp, repo, run_id, attempt, job_name, step, severity,
              message, signature = substring(signature, 0, 300)
}
